# ─────────────────────────────────────────────────────────────────
#  Brain Planet API — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://brain:brain_secret@localhost:5432/brain_planet

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Apple OAuth ───────────────────────────────────────────────────
APPLE_CLIENT_ID=com.brainplanet.app

# ── Firebase (for FCM push notifications) ────────────────────────
FIREBASE_PROJECT_ID=brain-planet
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@brain-planet.iam.gserviceaccount.com

# ── Cloudinary (for avatar uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AWS S3 (optional, for file storage) ──────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=brain-planet-assets
